  <!-- Feeds the dashboard's log-alerts widget (see StatusRoute/LogCapture) —
       every WARN+ event across the app, independent of what CONSOLE prints. -->
  <appender name="DASHBOARD" class="com.tibiabot.web.DashboardLogAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
  </appender>

  <logger name="club.minnced.discord.webhook.WebhookClient" level="ERROR" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <!-- JDA logs a WARN every time it hits a 429 and auto-retries internally —
       not a failure our code ever sees (the request still succeeds once the
       Retry-After elapses), just noise from the online-list lane's "shared"
       bucket occasionally getting hit despite its own slower pace + dedup.
       Suppressed now that the online-list lane has its own pace, dedup, and
       adaptive refresh backoff (AdaptiveRefreshInterval) to keep it from
       saturating in the first place — genuine ERROR-level events from this
       logger, if any, still surface on both console and the dashboard. -->
  <logger name="net.dv8tion.jda.api.requests.RestRateLimiter" level="ERROR" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <root level="INFO">
    <!-- <appender-ref ref="ASYNC_DISCORD" /> -->
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </root>

</configuration>

  <!-- Feeds the dashboard's log-alerts widget (see StatusRoute/LogCapture) —
       every WARN+ event across the app, independent of what CONSOLE prints. -->
  <appender name="DASHBOARD" class="com.tibiabot.web.DashboardLogAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
  </appender>

  <logger name="club.minnced.discord.webhook.WebhookClient" level="ERROR" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <!-- JDA logs a WARN every time it hits a 429 and auto-retries internally.
       That is not a failure our code ever sees (the request still succeeds
       once the Retry-After elapses), and in bursts it drowns the dashboard's
       alerts panel — but it is the only direct signal of how hard we are
       pushing Discord's shared bucket, so it is worth keeping somewhere.
       Console only (no DASHBOARD ref): visible in `docker logs` when
       diagnosing rate-limit pressure, without crowding out actionable
       warnings on the dashboard. additivity="false" stops the root logger
       re-adding the dashboard appender.

       Note this also keeps ERROR-level events from this logger off the
       dashboard, since a logger cannot route levels to different appenders
       — they are still on the console. -->
  <logger name="net.dv8tion.jda.api.requests.RestRateLimiter" level="WARN" additivity="false">
    <appender-ref ref="CONSOLE" />
  </logger>

  <root level="INFO">
    <!-- <appender-ref ref="ASYNC_DISCORD" /> -->
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </root>

</configuration>

  <!-- Feeds the dashboard's log-alerts widget (see StatusRoute/LogCapture) —
       every WARN+ event across the app, independent of what CONSOLE prints. -->
  <appender name="DASHBOARD" class="com.tibiabot.web.DashboardLogAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
  </appender>

  <logger name="club.minnced.discord.webhook.WebhookClient" level="ERROR" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <!-- JDA logs a WARN every time it hits a 429 and auto-retries internally.
       That is not a failure our code ever sees (the request still succeeds
       once the Retry-After elapses), but it is the only direct signal of how
       hard we are pushing Discord's shared bucket, so it belongs on the
       dashboard rather than being suppressed as it was previously.

       It is safe to surface at WARN because LogCapture keeps one entry per
       distinct message shape per logger and counts repeats, so even a heavy
       burst occupies a single row of the alerts panel instead of flooding
       it — the reason it was silenced before. -->
  <logger name="net.dv8tion.jda.api.requests.RestRateLimiter" level="WARN" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <!-- Hikari announces every pool it starts and every one it shuts down, at
       INFO. There is a pool per guild database (see PooledConnectionProvider),
       so at INFO that is two lines per guild the bot is asked about and two
       more whenever an idle one is swept — a steady trickle saying nothing.
       A pool that cannot be filled still says so, at WARN. -->
  <logger name="com.zaxxer.hikari" level="WARN" additivity="false">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </logger>

  <!-- And the pool itself says nothing at all.

       It logs "Exception during pool initialization" at ERROR whenever a
       database cannot be reached, and the commonest reason by far is one this
       bot does not consider an error: a guild it was never set up in has no
       `_<guildId>` database, and the settings sweep asks all of them (see
       JdbcRespawnRepository.settings, which reads SQLState 3D000 and answers
       None). Before there was a pool that was silent, and it should stay
       silent rather than putting a red row per unconfigured guild on the
       status dashboard's alerts panel every cycle.

       Nothing is lost that the application cannot say for itself: every
       failure this logger reports is also thrown to whoever asked for the
       connection, with Hikari's wrapper taken back off, so a genuine outage
       still surfaces wherever it actually matters.

       What this does give up is two warnings that share the logger — a
       retrograde clock change, and thread starvation detected by the pool's
       housekeeper. Both are diagnosable elsewhere, and neither is worth the
       noise this otherwise carries. -->
  <logger name="com.zaxxer.hikari.pool.HikariPool" level="OFF" />

  <root level="INFO">
    <!-- <appender-ref ref="ASYNC_DISCORD" /> -->
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="DASHBOARD" />
  </root>

</configuration>

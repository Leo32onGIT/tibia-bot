# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=change_me

# Tibiadata Configuration (public api, or your self-hosted local instance)
TIBIADATA_HOST=https://api.tibiadata.com

# Redis cache (optional). Set to the `redis` compose service name to enable
# caching; leave empty to disable it entirely (the bot runs unchanged without it).
# COMPOSE_PROFILES=local-cache,own-dashboard is what actually creates the redis
# and caddy containers (read by `docker compose` itself, not the bot) —
# required on a plain or primary deployment; leave unset on a secondary (see
# BOT_ROLE below), which has no use for its own Redis or dashboard and
# shouldn't run either.
COMPOSE_PROFILES=local-cache,own-dashboard
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Shared world-cycle role (optional). Leave both empty for a plain single-bot
# deployment (default; zero behaviour change). On a primary, set BOT_ROLE=primary
# and REDIS_PUBLISH_HOST to this host's own private IP so secondary bots
# elsewhere on the VPC can reach this Redis; on a secondary, set
# BOT_ROLE=secondary, remove/clear COMPOSE_PROFILES above (no local redis or
# dashboard needed), and point POSTGRES_HOST/REDIS_HOST at the primary's
# private IP instead of a local DB. Each bot's dashboard identity (name,
# avatar, user id) is read straight from its own Discord application via
# JDA — no separate labelling config needed.
BOT_ROLE=
REDIS_PUBLISH_HOST=

# Cache freshness — how long cached TibiaData API responses are reused before
# re-fetching. Optional; omit to use the defaults shown. Units: s/m/h/d.
# (All cache TTLs live together in discord.conf's `cache { }` block.)
# CACHE_BOOSTED_TTL=30m                  # boosted boss + creature
# CACHE_HIGHSCORES_TTL=30m               # /leaderboards highscores
# CACHE_WORLD_LIST_TTL=1h                # world list

# Monitoring dashboard (Discord-OAuth-gated /dashboard), served behind Caddy's
# automatic HTTPS. STATUS_DOMAIN is the bot's public apex domain — the SAME
# domain the existing GitHub Pages landing page is on. Caddy proxies
# /dashboard* on it to the bot and passes everything else through
# unauthenticated to GitHub Pages (see repo-root Caddyfile), so this domain's
# DNS needs to point at THIS host instead of GitHub Pages' IPs once Caddy is
# live — check whichever registrar you used for the domain. All three vars
# below are required for login to work end-to-end:
#   - DISCORD_CLIENT_SECRET: bot application's OAuth2 tab in the Developer
#     Portal (different credential from TOKEN above). Also add the redirect
#     URI there: https://<STATUS_DOMAIN>/dashboard/auth/callback
#   - SESSION_SECRET: any random 32+ byte string, used to sign the session cookie
#   - STATUS_DOMAIN: the domain Caddy requests a Let's Encrypt cert for, and
#     that the bot builds its OAuth redirect URI from
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
STATUS_DOMAIN=violentbot.xyz

# Respawn claim system (`/respawn` + the 📅・sᴘᴀᴡɴs forum channel). Off by
# default: while it is off the command is never registered with Discord and no
# forum channel is created, so a deploy carrying this code changes nothing.
# Turn it on only where you actually want the feature — enabling it makes the
# bot create a forum channel in every guild that runs /setup or /repair.
# RESPAWN_ENABLED=true
#
# Optional tuning (defaults shown). These seed a guild's settings the first
# time its forum is created; changing them later does NOT retune guilds that
# are already live — use `/respawn admin config` for that.
# RESPAWN_DEFAULT_DURATION_MINUTES=120  # claim length when the user doesn't say
# RESPAWN_MAX_DURATION_MINUTES=240      # ceiling on one claim, extensions included
# RESPAWN_QUEUE_LIMIT=20                # how many may wait behind a claim
# RESPAWN_STAMINA_MINUTES=240           # daily claim budget per user, 0 = unlimited
# RESPAWN_WARN_MINUTES=10               # DM the claimer this long before the end
# RESPAWN_HANDOVER_MINUTES=10            # how long to accept a handover offer before it passes on
# RESPAWN_SWEEP_INTERVAL=30s            # how often claims are expired and queues advanced
# RESPAWN_SCHEDULE_LOOK_AHEAD_MINUTES=720   # how far ahead slots are booked, and so how far ahead "hunting tonight?" may be asked (12h)
# RESPAWN_MAX_SCHEDULES_PER_USER=5      # standing bookings one member may hold
# RESPAWN_SLOT_REMINDER_MINUTES=15      # nudge a slot's owner this long before it starts (0 = off)
# RESPAWN_REQUEST_RESPONSE_MINUTES=60   # how long to answer "hunting tonight?" before the slot passes on

# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=change_me

# Tibiadata Configuration (public api, or your self-hosted local instance)
TIBIADATA_HOST=https://api.tibiadata.com

# Redis cache (optional; the bot runs unchanged without it). COMPOSE_PROFILES is
# read by `docker compose`, not the bot, and is what creates the redis and caddy
# containers — leave it unset on a secondary, which needs neither.
COMPOSE_PROFILES=local-cache,own-dashboard
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Shared world-cycle role (optional). Leave empty for a single-bot deployment.
# primary:   set REDIS_PUBLISH_HOST to this host's private IP so secondaries can reach this Redis.
# secondary: clear COMPOSE_PROFILES and point POSTGRES_HOST/REDIS_HOST at the primary's private IP.
BOT_ROLE=
REDIS_PUBLISH_HOST=

# Shared world cycle, character fetching. Only the primary's address is whitelisted
# by the character APIs, so the primary fetches and secondaries read what it publishes.
# Both default on and only apply to the matching role. Defaults shown.
#   SECONDARY_CONSUME_ONLY       secondary waits for the primary's sheet on a cache miss,
#                                reverting to fetching if the primary's heartbeat stops
#   PRIMARY_FETCHES_FLEET_WORLDS primary also polls worlds only a secondary serves, to publish them
# SECONDARY_CONSUME_ONLY=true
# PRIMARY_FETCHES_FLEET_WORLDS=true
# PRIMARY_HEARTBEAT_INTERVAL=10s
# FLEET_FETCH_FAN_OUT=8

# Cache freshness — how long cached TibiaData responses are reused. Units: s/m/h/d.
# Optional; defaults shown. (All TTLs live in discord.conf's `cache { }` block.)
# CACHE_BOOSTED_TTL=30m                  # boosted boss + creature
# CACHE_HIGHSCORES_TTL=30m               # /leaderboards highscores
# CACHE_WORLD_LIST_TTL=1h                # world list

# Character age cache — skips a fetch while the upstream copy provably cannot have
# changed yet. Set CHARACTER_CACHE_ENABLED=false to restore always-fetch.
# TIBIADATA_MAX_IN_FLIGHT=200            # ceiling on concurrent TibiaData requests, all worlds
# CHARACTER_CACHE_ENABLED=true
# CHARACTER_CACHE_TTL=300s               # Kong's own TTL on /v4/character; change only if upstream does
# CHARACTER_CACHE_MAX_STALE=15m          # stop covering failures with a stored sheet
# CHARACTER_CACHE_CANARY_FRACTION=0.02   # share fetched anyway, to keep the age histogram honest
# CHARACTER_CACHE_MAX_ENTRIES=20000      # per-world ceiling on remembered sheets

# CipSoft's official fansite API — a second source for character sheets, alongside
# TibiaData (which still serves the online list, guilds and boosted). Both cache for
# 300s, so the bot holds the windows out of phase and takes the fresher sheet: worst-case
# staleness drops 300s -> 180s, and either source covers the other's failures.
#   off    - default; no behaviour change
#   shadow - fetched and compared, never posted from. Watch "Fansite shadow divergence" at WARN.
#   race   - both sources out of phase, freshest sheet wins
# A mode set without a token degrades to off with a warning.
FANSITE_API_MODE=off
FANSITE_API_TOKEN=

# Optional; defaults shown.
# FANSITE_API_PHASE_OFFSET_TICKS=2       # poll ticks between the two cache windows
# FANSITE_API_MAX_IN_FLIGHT=8            # this API blocks the whole IP (403, not 429) if bursted.
#                                        # Raise only with evidence.
# FANSITE_API_CIRCUIT_OPEN_FOR=10m       # stop calling entirely for this long after a 403/429
# FANSITE_API_SECONDARY_GRACE=400ms      # how long the racer waits once TibiaData has answered
# FANSITE_API_BASE_URL=https://fansiteapi.tibia.com
# FANSITE_API_USER_AGENT=violentbot.xyz  # must be non-empty; Cloudflare 403s a default agent

# Monitoring dashboard (Discord-OAuth-gated /dashboard) behind Caddy's automatic HTTPS.
# STATUS_DOMAIN is the bot's public apex domain — the same one the GitHub Pages landing
# page uses, so its DNS must point at THIS host once Caddy is live. Caddy proxies
# /dashboard* to the bot and passes everything else through (see repo-root Caddyfile).
# All three are required for login:
#   DISCORD_CLIENT_SECRET  OAuth2 tab in the Developer Portal (not TOKEN above). Add the
#                          redirect URI there: https://<STATUS_DOMAIN>/dashboard/auth/callback
#   SESSION_SECRET         any random 32+ byte string, signs the session cookie
#   STATUS_DOMAIN          domain Caddy gets a cert for, and the OAuth redirect is built from
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
STATUS_DOMAIN=violentbot.xyz

# Respawn claim system (`/respawn` + the 📅・sᴘᴀᴡɴs forum channel). Off by default:
# while off, the command is never registered and no forum channel is created. Enabling
# it makes the bot create a forum channel in every guild that runs /setup or /repair.
# RESPAWN_ENABLED=true
#
# Optional tuning (defaults shown). These seed a guild's settings when its forum is first
# created; changing them later does not retune live guilds — use `/respawn admin config`.
# RESPAWN_DEFAULT_DURATION_MINUTES=120  # claim length when the user doesn't say
# RESPAWN_MAX_DURATION_MINUTES=240      # ceiling on one claim, extensions included
# RESPAWN_QUEUE_LIMIT=20                # how many may wait behind a claim
# RESPAWN_STAMINA_MINUTES=240           # daily claim budget per user, 0 = unlimited
# RESPAWN_WARN_MINUTES=10               # DM the claimer this long before the end
# RESPAWN_HANDOVER_MINUTES=10           # how long a handover offer stands before it passes on
# RESPAWN_SWEEP_INTERVAL=30s            # how often claims are expired and queues advanced
# RESPAWN_SCHEDULE_LOOK_AHEAD_MINUTES=720   # how far ahead slots may be booked (12h)
# RESPAWN_MAX_SCHEDULES_PER_USER=5      # standing bookings one member may hold
# RESPAWN_SLOT_REMINDER_MINUTES=15      # nudge a slot's owner before it starts (0 = off)
# RESPAWN_REQUEST_RESPONSE_MINUTES=60   # how long to answer "hunting tonight?" before it passes on

# JVM heap (optional, but set it per host — the default is actively harmful). Left unset,
# Java 8 takes a quarter of RAM and falls back to SerialGC on one vCPU, which pinned the
# old generation at 100% on both production hosts and burned 19%/83% of wall-clock in GC.
# Size Xmx at roughly twice the old generation's occupancy just after a full GC; NewRatio=3
# gives the old generation three quarters of the heap. Re-measure for a host with different RAM.
# JAVA_OPTS replaces the start script's own java_opts rather than adding to it, so repeat
# anything you rely on. (The build's own options arrive separately via conf/application.ini.)
#
#   1 vCPU / 2GB, sharing the box with postgres + redis + caddy (primary):
# JAVA_OPTS=-Djava.awt.headless=true -Xms640m -Xmx640m -XX:NewRatio=3
#   1 vCPU / 1GB, running only the bot (secondary):
# JAVA_OPTS=-Djava.awt.headless=true -Xms384m -Xmx384m -XX:NewRatio=3

# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=change_me

# Tibiadata Configuration (public api, or your self-hosted local instance)
TIBIADATA_HOST=https://api.tibiadata.com

# Redis cache (optional). Set to the `redis` compose service name to enable
# caching; leave empty to disable it entirely (the bot runs unchanged without it).
# COMPOSE_PROFILES=local-cache,own-dashboard is what actually creates the redis
# and caddy containers (read by `docker compose` itself, not the bot) —
# required on a plain or primary deployment; leave unset on a slave (see
# BOT_ROLE below), which has no use for its own Redis or dashboard and
# shouldn't run either.
COMPOSE_PROFILES=local-cache,own-dashboard
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Shared world-cycle role (optional). Leave both empty for a plain single-bot
# deployment (default; zero behaviour change). On a primary, set BOT_ROLE=primary
# and REDIS_PUBLISH_HOST to this host's own private IP so slave bots elsewhere
# on the VPC can reach this Redis; on a slave, set BOT_ROLE=slave, remove/clear
# COMPOSE_PROFILES above (no local redis or dashboard needed), and point
# POSTGRES_HOST/REDIS_HOST at the primary's private IP instead of a local DB.
# BOT_NAME labels this instance on a merged dashboard (e.g. "Blue"/"Red") —
# set it on every deployment sharing one dashboard, primary included.
BOT_ROLE=
BOT_NAME=
REDIS_PUBLISH_HOST=

# Cache freshness — how long cached TibiaData API responses are reused before
# re-fetching. Optional; omit to use the defaults shown. Units: s/m/h/d.
# (All cache TTLs live together in discord.conf's `cache { }` block.)
# CACHE_BOOSTED_TTL=30m                  # boosted boss + creature
# CACHE_HIGHSCORES_TTL=30m               # /leaderboards highscores
# CACHE_WORLD_LIST_TTL=1h                # world list
# CACHE_CHARACTER_SNAPSHOT_TTL=7d        # character-cache snapshot self-eviction
# CACHE_CHARACTER_SNAPSHOT_INTERVAL=60s  # how often that snapshot is written

# Monitoring dashboard (Discord-OAuth-gated /dashboard), served behind Caddy's
# automatic HTTPS. STATUS_DOMAIN is the bot's public apex domain — the SAME
# domain the existing GitHub Pages landing page is on. Caddy proxies
# /dashboard* on it to the bot and passes everything else through
# unauthenticated to GitHub Pages (see repo-root Caddyfile), so this domain's
# DNS needs to point at THIS host instead of GitHub Pages' IPs once Caddy is
# live — check whichever registrar you used for the domain. All three vars
# below are required for login to work end-to-end:
#   - DISCORD_CLIENT_SECRET: bot application's OAuth2 tab in the Developer
#     Portal (different credential from TOKEN above). Also add the redirect
#     URI there: https://<STATUS_DOMAIN>/dashboard/auth/callback
#   - SESSION_SECRET: any random 32+ byte string, used to sign the session cookie
#   - STATUS_DOMAIN: the domain Caddy requests a Let's Encrypt cert for, and
#     that the bot builds its OAuth redirect URI from
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
STATUS_DOMAIN=violentbot.xyz
